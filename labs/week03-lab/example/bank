# Complete this ATM simulation
balance = 1000
pin = "1234"

entered_pin = input("Enter PIN: ")
if entered_pin == pin:
    print("PIN accepted")
    while True:
        print("\n1. Check Balance")
        print("2. Withdraw")
        print("3. Deposit") 
        print("4. Exit")
        
        choice = input("Choose option: ")
        
        # Complete the menu logic here
        # Your code here:
        if choice == "1":
            print(f"Balance: {balance}")
        elif choice == "2":
            amount = float(input("Enter amount to withdown:"))
            if amount <= balance:
                balance -= amount
                print(f"withdown :{amount} balaance: {balance}")
        elif choice == "3":
            amount = float(input("Enter amount to deposit:"))
            if amount <= balance:
                balance += amount
                print(f"deposit : {amount} balancd: {balance}")
        elif choice == "4":
            print("Exit")
            break
else:
    print("Invalid PIN")